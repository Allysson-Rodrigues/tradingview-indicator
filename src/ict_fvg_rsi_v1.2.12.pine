// 🌐 VARIÁVEIS GLOBAIS
// ═══════════════════════════════════════════════════════════════════════════
var CandleSet htf1 = CandleSet.new(array.new<Candle>(), array.new<Imbalance>(), SettingsHTF1, na, na, na, na)
var CandleSet htf2 = CandleSet.new(array.new<Candle>(), array.new<Imbalance>(), SettingsHTF2, na, na, na, na)
var CandleSet htf3 = CandleSet.new(array.new<Candle>(), array.new<Imbalance>(), SettingsHTF3, na, na, na, na)
var CandleSet htf4 = CandleSet.new(array.new<Candle>(), array.new<Imbalance>(), SettingsHTF4, na, na, na, na)
var CandleSet htf5 = CandleSet.new(array.new<Candle>(), array.new<Imbalance>(), SettingsHTF5, na, na, na, na)
var CandleSet htf6 = CandleSet.new(array.new<Candle>(), array.new<Imbalance>(), SettingsHTF6, na, na, na, na)

var array<CandleSet> g_htfs = array.from(htf1, htf2, htf3, htf4, htf5, htf6)
var array<bool> g_prev_shows = array.from(true, true, true, true, true, true)

// [FIX v1.2.1] Helper removido — métodos convertidos em funções puras
var Trace trace = Trace.new()
// [FIX v1.2.0] var adicionado
var color color_transparent = #ffffff00

type RSISlot
    float rsi
    float close
    float auc
    float adc

// RSI
float RSI_ALPHA = 1.0 / i_rsi_length
var array<RSISlot> g_rsi_slots = array.new<RSISlot>(RSI_MTF_SLOT_COUNT)
if barstate.isfirst
    for i = 0 to RSI_MTF_SLOT_COUNT - 1
        g_rsi_slots.set(i, RSISlot.new(na, na, na, na))
var float g_cached_rsi25 = na
var float g_cached_rsi30 = na
var float g_cached_rsi50 = na
var float g_cached_rsi70 = na
var float g_cached_rsi75 = na
var float g_cached_rsi_custom = na
var int g_last_calc_bar = -1
var table g_rsi_table = na
var int g_prev_col_config = 0
var string g_prev_table_position = ''

// FVG Gráfico
var array<FVG> g_active_fvgs = array.new<FVG>()
var int g_last_fvg_time = 0
var array<int> g_fvg_to_remove = array.new<int>()
var int g_tf_seconds = 0
var table g_debug_table = na

// ═══════════════════════════════════════════════════════════════════════════
// 🔧 FUNÇÕES AUXILIARES - ICT
// ═══════════════════════════════════════════════════════════════════════════
f_line_style(string style) =>
    switch style
        '----' => line.style_dashed
        '····' => line.style_dotted
        => line.style_solid

// [FIX v1.2.0] DayofWeek corrigido — usa constantes Pine + default robusto
f_day_of_week(int index) =>
    if na(index)
        ''
    else
        switch index
            dayofweek.monday    => 'Seg'
            dayofweek.tuesday   => 'Ter'
            dayofweek.wednesday => 'Qua'
            dayofweek.thursday  => 'Qui'
            dayofweek.friday    => 'Sex'
            dayofweek.saturday  => 'Sáb'
            dayofweek.sunday    => 'Dom'
            => ''

// [FIX v1.2.0] ValidTimeframe usa modulo para precisão
f_valid_timeframe(string HTF) =>
    if timeframe.in_seconds(HTF) >= timeframe.in_seconds('D') and timeframe.in_seconds(HTF) > timeframe.in_seconds()
        true
    else
        n1 = timeframe.in_seconds()
        n2 = timeframe.in_seconds(HTF)
        n1 < n2 and n2 % n1 == 0

f_remaining_time(string HTF) =>
    if barstate.islast
        int closeTime = time_close(HTF)
        if na(closeTime)
            '--:--'
        else
            timeRemaining = int(math.max(0, (closeTime - timenow) / 1000))
            days = math.floor(timeRemaining / SEC_1D)
            hours = math.floor((timeRemaining - days * SEC_1D) / SEC_1H)
            minutes = math.floor((timeRemaining - days * SEC_1D - hours * SEC_1H) / 60)
            seconds = math.floor(timeRemaining - days * SEC_1D - hours * SEC_1H - minutes * 60)
            r = str.tostring(seconds, '00')
            if minutes > 0 or hours > 0 or days > 0
                r := str.tostring(minutes, '00') + ':' + r
            if hours > 0 or days > 0
                r := str.tostring(hours, '00') + ':' + r
            if days > 0
                r := str.tostring(days) + 'D ' + r
            r
    else
        '--:--'

f_htf_name(string HTF) =>
    seconds = timeframe.in_seconds(HTF)
    if seconds < 60
        str.tostring(seconds) + 's'
    else if seconds / 60 < 60
        str.tostring(seconds / 60) + 'm'
    else if seconds / 60 / 60 < 24
        str.tostring(seconds / 60 / 60) + 'H'
    else
        HTF

f_htf_enabled() =>
    array<bool> current_shows = array.from(SettingsHTF1.show, SettingsHTF2.show, SettingsHTF3.show, SettingsHTF4.show, htf5_show, htf6_show)
    int enabled = 0
    for i = 0 to 5
        if current_shows.get(i)
            enabled += 1
    math.min(enabled, settings.max_sets)

f_can_render_htf(bool isEnabled, string HTF, int renderedCount, int renderedTotal) =>
    isEnabled and f_valid_timeframe(HTF) and renderedCount < renderedTotal

f_should_show_trace(int renderedCount, int renderedTotal) =>
    settings.trace_anchor == 'First Timeframe' ? renderedCount == 0 : renderedTotal > 0 and renderedCount == renderedTotal - 1

f_htf_group_span(CandleSet candleSet) =>
    candleSet.candles.size() * settings.width + (candleSet.candles.size() > 0 ? (candleSet.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer

f_clear_trace_labels() =>
    if not na(trace.o_l)
        label.delete(trace.o_l)
        trace.o_l := na
    if not na(trace.c_l)
        label.delete(trace.c_l)
        trace.c_l := na
    if not na(trace.h_l)
        label.delete(trace.h_l)
        trace.h_l := na
    if not na(trace.l_l)
        label.delete(trace.l_l)
        trace.l_l := na

f_clear_trace() =>
    if not na(trace.o)
        line.delete(trace.o)
        trace.o := na
    if not na(trace.c)
        line.delete(trace.c)
        trace.c := na
    if not na(trace.h)
        line.delete(trace.h)
        trace.h := na
    if not na(trace.l)
        line.delete(trace.l)
        trace.l := na
    f_clear_trace_labels()

f_sync_trace_line(line currentLine, int x1, int x2, float price, color lineColor, string lineStyle, int lineWidth) =>
    line result = currentLine
    if not na(result)
        line.set_xy1(result, x1, price)
        line.set_xy2(result, x2, price)
        line.set_color(result, lineColor)
        line.set_style(result, f_line_style(lineStyle))
        line.set_width(result, lineWidth)
    else
        result := line.new(x1, price, x2, price, color=lineColor, style=f_line_style(lineStyle), width=lineWidth)
    result

f_sync_trace_label(label currentLabel, int x, float price, color textColor, string textSize) =>
    string priceText = str.tostring(price, format.mintick)
    label result = currentLabel
    if not na(result)
        label.set_xy(result, x, price)
        label.set_text(result, priceText)
        label.set_textcolor(result, textColor)
        label.set_size(result, textSize)
    else
        result := label.new(x, price, priceText, color=color_transparent, textcolor=textColor, style=label.style_label_left, size=textSize)
    result

f_candle_set_high(array<Candle> candles, float h) =>
    float _h = h
    if candles.size() > 0
        for i = 0 to candles.size() - 1
            if candles.get(i).h > _h
                _h := candles.get(i).h
    _h

f_candle_set_low(array<Candle> candles, float l) =>
    float _l = l
    if candles.size() > 0
        for i = 0 to candles.size() - 1
            if candles.get(i).l < _l
                _l := candles.get(i).l
    _l

f_candles_high() =>
    array<bool> current_shows = array.from(SettingsHTF1.show, SettingsHTF2.show, SettingsHTF3.show, SettingsHTF4.show, htf5_show, htf6_show)
    h = 0.0
    int cnt = 0
    int last = f_htf_enabled()
    for i = 0 to 5
        CandleSet cs = g_htfs.get(i)
        if f_can_render_htf(current_shows.get(i), cs.settings.htf, cnt, last)
            h := f_candle_set_high(cs.candles, h)
            cnt += 1
    h

f_candles_low(float h) =>
    array<bool> current_shows = array.from(SettingsHTF1.show, SettingsHTF2.show, SettingsHTF3.show, SettingsHTF4.show, htf5_show, htf6_show)
    l = h
    int cnt = 0
    int last = f_htf_enabled()
    for i = 0 to 5
        CandleSet cs = g_htfs.get(i)
        if f_can_render_htf(current_shows.get(i), cs.settings.htf, cnt, last)
            l := f_candle_set_low(cs.candles, l)
            cnt += 1
    l

// ═══════════════════════════════════════════════════════════════════════════
// 🔧 FUNÇÕES RSI
// ═══════════════════════════════════════════════════════════════════════════
f_rsi_ema_length() => math.max(1, 2 * i_rsi_length - 1)

f_rsi_color(float r) =>
    switch
        na(r)   => [color.new(#44475a, 0), color.new(#6272a4, 0)]  // Sem dado → Dracula comment
        r < 20  => [color.new(#14755f, 0), color.new(#f8f8f2, 0)]  // Muito sobrevendido → ciano escuro
        r < 30  => [color.new(#3de1c7, 0), color.new(#282a36, 0)]  // Sobrevendido → ciano médio
        r < 44  => [color.new(#b5f9ef, 0), color.new(#282a36, 0)]  // Leve alta → ciano pastel
        r <= 55 => [color.new(#282a36, 0), color.new(#f8f8f2, 0)]  // Neutro → fundo Dracula
        r < 70  => [color.new(#ffb8d0, 0), color.new(#282a36, 0)]  // Leve baixa → rosa pastel
        r < 80  => [color.new(#ff4d8d, 0), color.new(#282a36, 0)]  // Sobrecomprado → rosa médio
        =>         [color.new(#8b1048, 0), color.new(#f8f8f2, 0)]  // Muito sobrecomprado → rosa escuro


f_rsi_is_valid(float c, float au, float ad) =>
    not na(c) and not na(au) and not na(ad) and c > 0 and au >= 0 and ad >= 0

f_rsi_calc_price(float target_rsi, float close_val, float auc_val, float adc_val) =>
    if not f_rsi_is_valid(close_val, auc_val, adc_val) or target_rsi <= 0 or target_rsi >= 100
        na
    else
        alpha = RSI_ALPHA
        denominator = 100.0 - target_rsi
        if denominator == 0
            na
        else
            target_rs = target_rsi / denominator
            float calc_price = na
            if target_rsi < 50
                new_avg_up = (1 - alpha) * auc_val
                new_avg_down = target_rs == 0 ? na : new_avg_up / target_rs
                d_loss = na(new_avg_down) ? na : (new_avg_down - (1 - alpha) * adc_val) / alpha
                calc_price := na(d_loss) ? na : close_val - d_loss
            else
                new_avg_down = (1 - alpha) * adc_val
                new_avg_up = target_rs * new_avg_down
                d_gain = (new_avg_up - (1 - alpha) * auc_val) / alpha
                calc_price := close_val + d_gain
            if na(calc_price)
                na
            else
                min_p = close_val * (1 - i_rsi_max_deviation)
                max_p = close_val * (1 + i_rsi_max_deviation)
                math.max(min_p, math.min(max_p, calc_price))

f_rsi_pack() =>
    emaLen = f_rsi_ema_length()
    [close, ta.rsi(close, i_rsi_length), ta.ema(math.max(close - close[1], 0), emaLen), ta.ema(math.max(close[1] - close, 0), emaLen)]

f_rsi_pack_confirmed() =>
    emaLen = f_rsi_ema_length()
    [close[1], ta.rsi(close, i_rsi_length)[1], ta.ema(math.max(close - close[1], 0), emaLen)[1], ta.ema(math.max(close[1] - close, 0), emaLen)[1]]

f_rsi_tf_display(int index) =>
    switch index
        0 => i_rsi_tf1_name
        1 => i_rsi_tf2_name
        2 => i_rsi_tf3_name
        3 => i_rsi_tf4_name
        => i_rsi_tf5_name

f_request_rsi_pack(string targetTf, bool useConfirmedHtfSecurity, int chartTfSeconds, int calcBarsCount) =>
    int targetTfSeconds = timeframe.in_seconds(targetTf)
    bool useLocal = targetTfSeconds == chartTfSeconds
    bool useConfirmed = useConfirmedHtfSecurity and targetTfSeconds > chartTfSeconds
    [localClose, localRsi, localAuc, localAdc] = f_rsi_pack()
    [confirmedClose, confirmedRsi, confirmedAuc, confirmedAdc] = request.security(syminfo.tickerid, targetTf, f_rsi_pack_confirmed(), lookahead=barmerge.lookahead_on, gaps=barmerge.gaps_off, calc_bars_count=calcBarsCount)
    [realtimeClose, realtimeRsi, realtimeAuc, realtimeAdc] = request.security(syminfo.tickerid, targetTf, f_rsi_pack(), lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off, calc_bars_count=calcBarsCount)
    if useLocal
        [localClose, localRsi, localAuc, localAdc]
    else if useConfirmed
        [confirmedClose, confirmedRsi, confirmedAuc, confirmedAdc]
    else
        [realtimeClose, realtimeRsi, realtimeAuc, realtimeAdc]

f_table_seed_cells(table tbl, int cols, int rows) =>
    for row = 0 to rows - 1
        for col = 0 to cols - 1
            table.cell(tbl, col, row, '', text_color=color.new(#f8f8f2, 0), bgcolor=color.new(#282a36, 0), text_size=size.small)

f_table_set_cell(table tbl, int col, int row, string txt, color bg, color txtClr, string txtSize) =>
    table.cell_set_text(tbl, col, row, txt)
    table.cell_set_bgcolor(tbl, col, row, bg)
    table.cell_set_text_color(tbl, col, row, txtClr)
    table.cell_set_text_size(tbl, col, row, txtSize)

// ═══════════════════════════════════════════════════════════════════════════
// 🔧 FUNÇÕES FVG GRÁFICO
// ═══════════════════════════════════════════════════════════════════════════
f_fvg_get_tf_multiplier(int tf_sec) =>
    float result = switch
        tf_sec <= 60 => 0.5
        tf_sec <= 300 => 0.5 + (tf_sec - 60) * (0.75 - 0.5) / (300 - 60)
        tf_sec <= 900 => 0.75 + (tf_sec - 300) * (1.0 - 0.75) / (900 - 300)
        tf_sec <= SEC_1H => 1.0 + (tf_sec - 900) * (1.5 - 1.0) / (SEC_1H - 900)
        tf_sec <= SEC_4H => 1.5 + (tf_sec - SEC_1H) * (2.2 - 1.5) / (SEC_4H - SEC_1H)
        tf_sec <= SEC_1D => 2.2 + (tf_sec - SEC_4H) * (4.0 - 2.2) / (SEC_1D - SEC_4H)
        => 8.0
    math.min(i_fvg_max_multiplier, result)

f_fvg_get_mitigation_level(float top, float bottom, string mitType, bool isBull) =>
    if mitType == '100% (Completo)'
        isBull ? bottom : top
    else if mitType == '25% (Conservador)'
        isBull ? top - (top - bottom) * 0.25 : bottom + (top - bottom) * 0.25
    else
        (top + bottom) / 2.0

method draw(FVG this) =>
    if not na(this) and this.isActive
        x1 = this.birthTime
        // A projeção usa tempo-relógio do timeframe do FVG para manter compatibilidade com xloc.bar_time.
        x2 = this.birthTime + (g_tf_seconds * MS_PER_SECOND * i_fvg_extend_bars)
        boxColor = this.isBull ? i_fvg_bull_color : i_fvg_bear_color
        this.boxObj := box.new(left=x1, top=this.top, right=x2, bottom=this.bottom, xloc=xloc.bar_time, border_color=na, bgcolor=boxColor)

method remove(FVG this, bool wasMitigated, float mitigationPrice) =>
    if not na(this)
        if not na(this.boxObj)
            this.boxObj.delete()
            this.boxObj := na
        this.isActive := false

method checkMitigation(FVG this) =>
    bool isMitigated = false
    float mitigationLevel = f_fvg_get_mitigation_level(this.top, this.bottom, i_fvg_mitigation_type, this.isBull)
    if time > this.birthTime
        isMitigated := this.isBull ? (low <= mitigationLevel) : (high >= mitigationLevel)
    [isMitigated, mitigationLevel]

method isExpired(FVG this) =>
    if this.birthBarIndex < 0
        false
    else
        barsAge = bar_index - this.birthBarIndex
        barsAge > i_fvg_max_age

f_fvg_detect() =>
    float atr_value = i_fvg_auto_threshold or i_fvg_debug ? ta.atr(i_atr_period) : na
    float threshold = na
    float bullGapSize = na
    float bearGapSize = na
    if i_fvg_auto_threshold
        float atr_safe = math.max(atr_value, syminfo.mintick)
        threshold := 1.0
        if i_fvg_adaptive_tf
            threshold := threshold * f_fvg_get_tf_multiplier(g_tf_seconds)
        bullGapSize := (low - high[2]) / atr_safe
        bearGapSize := (low[2] - high) / atr_safe
    else
        threshold := i_fvg_threshold / 100.0
        if i_fvg_adaptive_tf
            threshold := threshold * f_fvg_get_tf_multiplier(g_tf_seconds)
        bullGapSize := (low - high[2]) / math.max(high[2], syminfo.mintick)
        bearGapSize := (low[2] - high) / math.max(low[2], syminfo.mintick)
    isBullFvg = low > high[2] and bullGapSize > threshold
    isBearFvg = high < low[2] and bearGapSize > threshold
    bool hasEnoughBars = bar_index >= 2 and not na(time[2])
    FVG newFvg = isBullFvg and hasEnoughBars ? FVG.new(low, high[2], true, time[2], bar_index - 2, na, na, true) : isBearFvg and hasEnoughBars ? FVG.new(low[2], high, false, time[2], bar_index - 2, na, na, true) : FVG.new(na, na, false, 0, -1, na, na, false)
    [isBullFvg, isBearFvg, newFvg, threshold, atr_value]

f_fvg_detect_confirmed() =>
    float atr_value = i_fvg_auto_threshold or i_fvg_debug ? ta.atr(i_atr_period)[1] : na
    float threshold = na
    float bullGapSize = na
    float bearGapSize = na
    if i_fvg_auto_threshold
        float atr_safe = math.max(atr_value, syminfo.mintick)
        threshold := 1.0
        if i_fvg_adaptive_tf
            threshold := threshold * f_fvg_get_tf_multiplier(g_tf_seconds)
        bullGapSize := (low[1] - high[3]) / atr_safe
        bearGapSize := (low[3] - high[1]) / atr_safe
    else
        threshold := i_fvg_threshold / 100.0
        if i_fvg_adaptive_tf
            threshold := threshold * f_fvg_get_tf_multiplier(g_tf_seconds)
        bullGapSize := (low[1] - high[3]) / math.max(high[3], syminfo.mintick)
        bearGapSize := (low[3] - high[1]) / math.max(low[3], syminfo.mintick)
    isBullFvg = low[1] > high[3] and bullGapSize > threshold
    isBearFvg = high[1] < low[3] and bearGapSize > threshold
    bool hasEnoughBars = bar_index >= 3 and not na(time[3])
    FVG newFvg = isBullFvg and hasEnoughBars ? FVG.new(low[1], high[3], true, time[3], -1, na, na, true) : isBearFvg and hasEnoughBars ? FVG.new(low[3], high[1], false, time[3], -1, na, na, true) : FVG.new(na, na, false, 0, -1, na, na, false)
    [isBullFvg, isBearFvg, newFvg, threshold, atr_value]

f_request_fvg_detection(string targetTf, bool useConfirmedHtfSecurity, int chartTfSeconds, int calcBarsCount) =>
    int targetTfSeconds = timeframe.in_seconds(targetTf)
    bool useLocal = targetTfSeconds == chartTfSeconds
    bool useConfirmed = useConfirmedHtfSecurity and targetTfSeconds > chartTfSeconds
    [localBull, localBear, localFvg, localThreshold, localAtr] = f_fvg_detect()
    [confirmedBull, confirmedBear, confirmedFvg, confirmedThreshold, confirmedAtr] = request.security(syminfo.tickerid, targetTf, f_fvg_detect_confirmed(), lookahead=barmerge.lookahead_on, gaps=barmerge.gaps_off, calc_bars_count=calcBarsCount)
    [realtimeBull, realtimeBear, realtimeFvg, realtimeThreshold, realtimeAtr] = request.security(syminfo.tickerid, targetTf, f_fvg_detect(), lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off, calc_bars_count=calcBarsCount)
    if useLocal
        [localBull, localBear, localFvg, localThreshold, localAtr]
    else if useConfirmed
        [confirmedBull, confirmedBear, confirmedFvg, confirmedThreshold, confirmedAtr]
    else
        [realtimeBull, realtimeBear, realtimeFvg, realtimeThreshold, realtimeAtr]

// ═══════════════════════════════════════════════════════════════════════════
// 🧱 MÉTODOS CANDLESET
// ═══════════════════════════════════════════════════════════════════════════
method UpdateTime(CandleSet candleSet) =>
    if candleSet.candles.size() > 0
        Candle candle = candleSet.candles.get(0)
        candle.c := close
        candle.c_idx := bar_index
        if high > candle.h
            candle.h := high
            candle.h_idx := bar_index
        if low < candle.l
            candle.l := low
            candle.l_idx := bar_index
    candleSet

method ClearTopHtfLabels(CandleSet candleSet) =>
    if not na(candleSet.tfNameTop)
        candleSet.tfNameTop.delete()
        candleSet.tfNameTop := na
    if not na(candleSet.tfTimerTop)
        candleSet.tfTimerTop.delete()
        candleSet.tfTimerTop := na
    candleSet

method ClearBottomHtfLabels(CandleSet candleSet) =>
    if not na(candleSet.tfNameBottom)
        candleSet.tfNameBottom.delete()
        candleSet.tfNameBottom := na
    if not na(candleSet.tfTimerBottom)
        candleSet.tfTimerBottom.delete()
        candleSet.tfTimerBottom := na
    candleSet

method ClearHtfLabels(CandleSet candleSet) =>
    candleSet.ClearTopHtfLabels()
    candleSet.ClearBottomHtfLabels()
    candleSet

method SyncHtfLabels(CandleSet candleSet, int left, float top, float bottom) =>
    bool hasCandles = candleSet.candles.size() > 0
    if not settings.htf_label_show or not hasCandles
        candleSet.ClearHtfLabels()
    else
        string labelText = f_htf_name(candleSet.settings.htf)
        string labelTextTop = labelText
        string labelTextBottom = labelText
        if settings.htf_timer_show
            labelTextTop += '\n'
            labelTextBottom := '\n' + labelTextBottom
        if settings.daily_name
            labelTextTop += '\n'
        string timerText = '(' + f_remaining_time(candleSet.settings.htf) + ')' + (settings.daily_name ? '\n' : '')
        bool showTop = settings.label_position == 'Both' or settings.label_position == 'Top'
        bool showBottom = settings.label_position == 'Both' or settings.label_position == 'Bottom'
        if showTop
            if not na(candleSet.tfNameTop)
                candleSet.tfNameTop.set_xy(left, top)
                candleSet.tfNameTop.set_text(labelTextTop)
                candleSet.tfNameTop.set_textcolor(settings.htf_label_color)
                candleSet.tfNameTop.set_size(settings.htf_label_size)
            else
                candleSet.tfNameTop := label.new(left, top, labelTextTop, color=color_transparent, textcolor=settings.htf_label_color, style=label.style_label_down, size=settings.htf_label_size)
            if settings.htf_timer_show
                if not na(candleSet.tfTimerTop)
                    candleSet.tfTimerTop.set_xy(left, top)
                    candleSet.tfTimerTop.set_text(timerText)
                    candleSet.tfTimerTop.set_textcolor(settings.htf_timer_color)
                    candleSet.tfTimerTop.set_size(settings.htf_timer_size)
                else
                    candleSet.tfTimerTop := label.new(left, top, timerText, color=color_transparent, textcolor=settings.htf_timer_color, style=label.style_label_down, size=settings.htf_timer_size)
            else if not na(candleSet.tfTimerTop)
                candleSet.tfTimerTop.delete()
                candleSet.tfTimerTop := na
        else
            candleSet.ClearTopHtfLabels()
        if showBottom
            if not na(candleSet.tfNameBottom)
                candleSet.tfNameBottom.set_xy(left, bottom)
                candleSet.tfNameBottom.set_text(labelTextBottom)
                candleSet.tfNameBottom.set_textcolor(settings.htf_label_color)
                candleSet.tfNameBottom.set_size(settings.htf_label_size)
            else
                candleSet.tfNameBottom := label.new(left, bottom, labelTextBottom, color=color_transparent, textcolor=settings.htf_label_color, style=label.style_label_up, size=settings.htf_label_size)
            if settings.htf_timer_show
                if not na(candleSet.tfTimerBottom)
                    candleSet.tfTimerBottom.set_xy(left, bottom)
                    candleSet.tfTimerBottom.set_text(timerText)
                    candleSet.tfTimerBottom.set_textcolor(settings.htf_timer_color)
                    candleSet.tfTimerBottom.set_size(settings.htf_timer_size)
                else
                    candleSet.tfTimerBottom := label.new(left, bottom, timerText, color=color_transparent, textcolor=settings.htf_timer_color, style=label.style_label_up, size=settings.htf_timer_size)
            else if not na(candleSet.tfTimerBottom)
                candleSet.tfTimerBottom.delete()
                candleSet.tfTimerBottom := na
        else
            candleSet.ClearBottomHtfLabels()
    candleSet

method Reorder(CandleSet candleSet, int offset) =>
    size = candleSet.candles.size()
    if size > 0 and (barstate.isnew or barstate.islast or barstate.isrealtime)
        for i = size - 1 to 0
            Candle candle = candleSet.candles.get(i)
            t_buffer = offset + (settings.width + settings.buffer) * (size - i - 1)
            box.set_left(candle.body, bar_index + t_buffer)
            box.set_right(candle.body, bar_index + settings.width + t_buffer)
            line.set_x1(candle.wick_up, bar_index + settings.width / 2 + t_buffer)
            line.set_x2(candle.wick_up, bar_index + settings.width / 2 + t_buffer)
            line.set_x1(candle.wick_down, bar_index + settings.width / 2 + t_buffer)
            line.set_x2(candle.wick_down, bar_index + settings.width / 2 + t_buffer)
            if settings.daily_name
                if not na(candle.dow_label)
                    candle.dow_label.set_y(candle.h)
                    candle.dow_label.set_x(bar_index + settings.width / 2 + t_buffer)
                    candle.dow_label.set_text(candle.dow)
                    candle.dow_label.set_textcolor(settings.dow_color)
                    candle.dow_label.set_size(settings.dow_size)
                else
                    candle.dow_label := label.new(bar_index + settings.width / 2 + t_buffer, candle.h, candle.dow, color=color_transparent, textcolor=settings.dow_color, style=label.style_label_down, size=settings.dow_size)
            else if not na(candle.dow_label)
                candle.dow_label.delete()
                candle.dow_label := na
    top = 0.0
    bottom = 0.0
    if settings.label_alignment == 'Align'
        top := f_candles_high()
        bottom := f_candles_low(top)
    if settings.label_alignment == 'Follow Candles'
        top := f_candle_set_high(candleSet.candles, 0)
        bottom := f_candle_set_low(candleSet.candles, top)
    int left = bar_index + offset
    if size > 0
        left := bar_index + offset + (settings.width + settings.buffer) * (size - 1) / 2
    candleSet.SyncHtfLabels(left, top, bottom)
    if candleSet.imbalances.size() > 0
        for i = 0 to candleSet.imbalances.size() - 1
            Imbalance imb = candleSet.imbalances.get(i)
            t_buf2 = offset + (settings.width + settings.buffer) * (size - imb.arr_i2 - 1)
            t_buf1 = offset + (settings.width + settings.buffer) * (size - imb.arr_i1 - 1)
            box.set_left(imb.b, bar_index + t_buf2)
            box.set_right(imb.b, bar_index + t_buf1 + settings.width)
    candleSet

method Update(CandleSet candleSet, int offset, bool showTrace) =>
    candleSet.Reorder(offset)
    if candleSet.candles.size() > 0
        Candle candle = candleSet.candles.get(0)
        bull = candle.c > candle.o
        box.set_top(candle.body, math.max(candle.o, candle.c))
        box.set_bottom(candle.body, math.min(candle.o, candle.c))
        box.set_bgcolor(candle.body, bull ? settings.bull_body : settings.bear_body)
        box.set_border_color(candle.body, bull ? settings.bull_border : settings.bear_border)
        line.set_y1(candle.wick_up, candle.h)
        line.set_y2(candle.wick_up, math.max(candle.o, candle.c))
        line.set_color(candle.wick_up, bull ? settings.bull_wick : settings.bear_wick)
        line.set_y1(candle.wick_down, math.min(candle.o, candle.c))
        line.set_y2(candle.wick_down, candle.l)
        line.set_color(candle.wick_down, bull ? settings.bull_wick : settings.bear_wick)
        if showTrace and settings.trace_show
            t_buffer = offset + (settings.width + settings.buffer) * (candleSet.candles.size() - 1)
            int x1 = bar_index
            int x2 = bar_index + t_buffer
            trace.o := f_sync_trace_line(trace.o, x1, x2, candle.o, settings.trace_o_color, settings.trace_o_style, settings.trace_o_size)
            trace.c := f_sync_trace_line(trace.c, x1, x2, candle.c, settings.trace_c_color, settings.trace_c_style, settings.trace_c_size)
            trace.h := f_sync_trace_line(trace.h, x1, x2, candle.h, settings.trace_h_color, settings.trace_h_style, settings.trace_h_size)
            trace.l := f_sync_trace_line(trace.l, x1, x2, candle.l, settings.trace_l_color, settings.trace_l_style, settings.trace_l_size)
            if settings.label_show
                int labelX = bar_index + t_buffer + settings.width
                trace.o_l := f_sync_trace_label(trace.o_l, labelX, candle.o, settings.label_color, settings.label_size)
                trace.c_l := f_sync_trace_label(trace.c_l, labelX, candle.c, settings.label_color, settings.label_size)
                trace.h_l := f_sync_trace_label(trace.h_l, labelX, candle.h, settings.label_color, settings.label_size)
                trace.l_l := f_sync_trace_label(trace.l_l, labelX, candle.l, settings.label_color, settings.label_size)
    candleSet

method FindImbalance(CandleSet candleSet) =>
    int candleCount = candleSet.candles.size()
    if candleCount >= 3 and (barstate.isrealtime or barstate.islast)
        Candle lastCandle = candleSet.candles.get(candleCount - 1)
        int currentCandleIdx = lastCandle.o_idx
        int lastProcessedIdx = candleSet.imbalances.size() > 0 ? candleSet.imbalances.get(candleSet.imbalances.size() - 1).idx : -1
        // [FIX v1.2.2] Dirty flag: só reprocessa se há candle novo
        bool isNewCandle = currentCandleIdx != lastProcessedIdx
        if isNewCandle and (barstate.isconfirmed or barstate.ishistory)
            if candleSet.imbalances.size() > 0
                for i = candleSet.imbalances.size() - 1 to 0
                    Imbalance del = candleSet.imbalances.get(i)
                    box.delete(del.b)
                    candleSet.imbalances.pop()
            if candleCount >= 3 and settings.fvg_show
                for i = 0 to candleCount - 3 by 1
                    candle1 = candleSet.candles.get(i)
                    candle2 = candleSet.candles.get(i + 2)
                    if candle1.l > candle2.h and math.min(candle1.o, candle1.c) > math.max(candle2.o, candle2.c)
                        Imbalance imb = Imbalance.new()
                        imb.b := box.new(box.get_left(candle2.body), candle2.h, box.get_right(candle1.body), candle1.l, bgcolor=settings.fvg_color, border_color=color_transparent)
                        imb.idx := currentCandleIdx
                        imb.arr_i1 := i
                        imb.arr_i2 := i + 2
                        candleSet.imbalances.push(imb)
                    if candle1.h < candle2.l and math.max(candle1.o, candle1.c) < math.min(candle2.o, candle2.c)
                        Imbalance imb = Imbalance.new()
                        imb.b := box.new(box.get_right(candle1.body), candle1.h, box.get_left(candle2.body), candle2.l, bgcolor=settings.fvg_color, border_color=color_transparent)
                        imb.idx := currentCandleIdx
                        imb.arr_i1 := i
                        imb.arr_i2 := i + 2
                        candleSet.imbalances.push(imb)
            if candleCount > 2 and settings.vi_show
                for i = 0 to candleCount - 2 by 1
                    candle1 = candleSet.candles.get(i)
                    candle2 = candleSet.candles.get(i + 1)
                    if candle1.l < candle2.h and math.min(candle1.o, candle1.c) > math.max(candle2.o, candle2.c)
                        Imbalance imb = Imbalance.new()
                        imb.b := box.new(box.get_left(candle2.body), math.min(candle1.o, candle1.c), box.get_right(candle1.body), math.max(candle2.o, candle2.c), bgcolor=settings.vi_color, border_color=color_transparent)
                        imb.idx := currentCandleIdx
                        imb.arr_i1 := i
                        imb.arr_i2 := i + 1
                        candleSet.imbalances.push(imb)
                    if candle1.h > candle2.l and math.max(candle1.o, candle1.c) < math.min(candle2.o, candle2.c)
                        Imbalance imb = Imbalance.new()
                        imb.b := box.new(box.get_right(candle1.body), math.min(candle2.o, candle2.c), box.get_left(candle2.body), math.max(candle1.o, candle1.c), bgcolor=settings.vi_color, border_color=color_transparent)
                        imb.idx := currentCandleIdx
                        imb.arr_i1 := i
                        imb.arr_i2 := i + 1
                        candleSet.imbalances.push(imb)
    candleSet

// [FIX v1.2.3] Monitor extraído para consistency (evita warnings ta.change)
method Monitor(CandleSet candleSet, bool isNewHTFCandle) =>
    // Anti-repaint: cria em barra confirmada, com fallback para carga histórica
    if isNewHTFCandle and (barstate.isconfirmed or barstate.ishistory)
        Candle candle = Candle.new()
        candle.o := open, candle.c := close, candle.h := high, candle.l := low
        candle.o_time := time, candle.o_idx := bar_index, candle.c_idx := bar_index
        candle.h_idx := bar_index, candle.l_idx := bar_index
        // [FIX v1.2.0] Usa timeframe.in_seconds() em vez de str.tonumber()
        int htfSec = timeframe.in_seconds(candleSet.settings.htf)
        candle.dow := switch
            candleSet.settings.htf == '1W' => 'Sem ' + str.tostring(weekofyear(time, i_timezone))
            candleSet.settings.htf == '1D' => f_day_of_week(dayofweek(time_tradingday))
            htfSec < SEC_1H => str.format_time(candle.o_time, 'm', i_timezone)
            htfSec >= SEC_1H and htfSec < SEC_1D => str.format_time(candle.o_time, 'H', i_timezone)
            => ''
        bull = candle.c > candle.o
        candle.body := box.new(bar_index, math.max(candle.o, candle.c), bar_index + 2, math.min(candle.o, candle.c), bull ? settings.bull_border : settings.bear_border, 1, bgcolor=bull ? settings.bull_body : settings.bear_body)
        candle.wick_up := line.new(bar_index + 1, candle.h, bar_index, math.max(candle.o, candle.c), color=bull ? settings.bull_wick : settings.bear_wick)
        candle.wick_down := line.new(bar_index + 1, math.min(candle.o, candle.c), bar_index, candle.l, color=bull ? settings.bull_wick : settings.bear_wick)
        candleSet.candles.unshift(candle)
        if candleSet.candles.size() > candleSet.settings.max_display
            Candle delCandle = array.pop(candleSet.candles)
            box.delete(delCandle.body)
            line.delete(delCandle.wick_up)
            line.delete(delCandle.wick_down)
            if not na(delCandle.dow_label)
                delCandle.dow_label.delete()
    candleSet

f_process_htf(CandleSet candleSet, bool isNewHTFCandle, int renderedCount, int renderedTotal, int offset) =>
    bool showTrace = f_should_show_trace(renderedCount, renderedTotal)
    CandleSet workingSet = candleSet
    workingSet := workingSet.Monitor(isNewHTFCandle)
    workingSet := workingSet.UpdateTime()
    workingSet := workingSet.Update(offset, showTrace)
    workingSet := workingSet.FindImbalance()
    [renderedCount + 1, offset + f_htf_group_span(workingSet)]

// ═══════════════════════════════════════════════════════════════════════════
// 📊 CÁLCULOS & REQUEST.SECURITY
// ═══════════════════════════════════════════════════════════════════════════

ema_value = ta.ema(i_emaSource, i_emaLength)
rsiEmaLength = f_rsi_ema_length()
rsi_current = ta.rsi(close, i_rsi_length)
auc_current = ta.ema(math.max(close - close[1], 0), rsiEmaLength)
adc_current = ta.ema(math.max(close[1] - close, 0), rsiEmaLength)
bool useConfirmedHtfSecurity = i_htf_security_mode == 'Confirmado'
int rsiCalcBarsCount = math.max(RSI_REQUEST_MIN_BARS, i_rsi_length * 6)
bool hasCustomFvgTf = i_fvg_timeframe != ''
int chartTfSeconds = timeframe.in_seconds()
int fvgTfSeconds = hasCustomFvgTf ? timeframe.in_seconds(i_fvg_timeframe) : chartTfSeconds
bool fvgTfIsLower = hasCustomFvgTf and fvgTfSeconds < chartTfSeconds
int fvgCalcBarsCount = math.max(FVG_REQUEST_MIN_BARS, i_atr_period + 10)

if i_fvg_enabled and fvgTfIsLower and barstate.isfirst
    runtime.error('O timeframe do FVG deve ser igual ou maior que o timeframe do gráfico atual. Para LTF, use request.security_lower_tf em uma implementação dedicada.')

// Pine exige chamadas consistentes nesse bloco. Aqui deixamos as 5 leituras explícitas.
[closeVal1, rsiVal1, aucVal1, adcVal1] = f_request_rsi_pack(i_rsi_tf1, useConfirmedHtfSecurity, chartTfSeconds, rsiCalcBarsCount)
RSISlot s0 = g_rsi_slots.get(0)
s0.close := closeVal1
s0.rsi := rsiVal1
s0.auc := aucVal1
s0.adc := adcVal1

[closeVal2, rsiVal2, aucVal2, adcVal2] = f_request_rsi_pack(i_rsi_tf2, useConfirmedHtfSecurity, chartTfSeconds, rsiCalcBarsCount)
RSISlot s1 = g_rsi_slots.get(1)
s1.close := closeVal2
s1.rsi := rsiVal2
s1.auc := aucVal2
s1.adc := adcVal2

[closeVal3, rsiVal3, aucVal3, adcVal3] = f_request_rsi_pack(i_rsi_tf3, useConfirmedHtfSecurity, chartTfSeconds, rsiCalcBarsCount)
RSISlot s2 = g_rsi_slots.get(2)
s2.close := closeVal3
s2.rsi := rsiVal3
s2.auc := aucVal3
s2.adc := adcVal3

[closeVal4, rsiVal4, aucVal4, adcVal4] = f_request_rsi_pack(i_rsi_tf4, useConfirmedHtfSecurity, chartTfSeconds, rsiCalcBarsCount)
RSISlot s3 = g_rsi_slots.get(3)
s3.close := closeVal4
s3.rsi := rsiVal4
s3.auc := aucVal4
s3.adc := adcVal4

[closeVal5, rsiVal5, aucVal5, adcVal5] = f_request_rsi_pack(i_rsi_tf5, useConfirmedHtfSecurity, chartTfSeconds, rsiCalcBarsCount)
RSISlot s4 = g_rsi_slots.get(4)
s4.close := closeVal5
s4.rsi := rsiVal5
s4.auc := aucVal5
s4.adc := adcVal5

tfFinal = hasCustomFvgTf ? i_fvg_timeframe : timeframe.period
g_tf_seconds := fvgTfSeconds
[isBull, isBear, detectedFvg, thresholdUsed, atrValue] = f_request_fvg_detection(tfFinal, useConfirmedHtfSecurity, chartTfSeconds, fvgCalcBarsCount)

// ═══════════════════════════════════════════════════════════════════════════
// ⚡ LÓGICA PRINCIPAL - FVG GRÁFICO
// ═══════════════════════════════════════════════════════════════════════════
bool didAddBullFvg = false
bool didAddBearFvg = false

if i_fvg_enabled and barstate.isconfirmed and (isBull or isBear) and detectedFvg.birthTime > g_last_fvg_time
    if g_active_fvgs.size() < i_fvg_max_count and detectedFvg.isActive
        g_last_fvg_time := detectedFvg.birthTime
        detectedFvg.birthBarIndex := bar_index
        detectedFvg.draw()
        g_active_fvgs.unshift(detectedFvg)
        didAddBullFvg := isBull
        didAddBearFvg := isBear

// [FIX v1.2.0] Anti-repaint: mitigação/expiração APENAS em barstate.isconfirmed
if i_fvg_enabled and barstate.isconfirmed and g_active_fvgs.size() > 0
    if g_fvg_to_remove.size() > 0
        g_fvg_to_remove.clear()
    int arraySize = g_active_fvgs.size()
    for i = 0 to arraySize - 1
        fvg = g_active_fvgs.get(i)
        if fvg.isActive
            [wasMitigated, mitigationPrice] = fvg.checkMitigation()
            wasExpired = fvg.isExpired()
            if wasMitigated or wasExpired
                fvg.remove(wasMitigated, mitigationPrice)
                g_fvg_to_remove.push(i)
    if g_fvg_to_remove.size() > 0
        g_fvg_to_remove.sort(order.descending)
        for i = 0 to g_fvg_to_remove.size() - 1
            g_active_fvgs.remove(g_fvg_to_remove.get(i))

// [FIX v1.2.0] Garbage collection: limpa FVGs quando feature desligada
if not i_fvg_enabled and g_active_fvgs.size() > 0
    for i = 0 to g_active_fvgs.size() - 1
        fvg = g_active_fvgs.get(i)
        if fvg.isActive
            fvg.remove(false, na)
    g_active_fvgs.clear()
    g_last_fvg_time := 0

// === BLOCO DE CACHE RSI ===
bool use_rsi_25 = i_show_rsi_25
bool use_rsi_30 = i_show_rsi_30
bool use_rsi_50 = i_show_rsi_50
bool use_rsi_70 = i_show_rsi_70
bool use_rsi_75 = i_show_rsi_75
bool use_rsi_custom = i_show_rsi_custom

bool should_calculate = barstate.isnew or (barstate.islast and g_last_calc_bar != bar_index)
if should_calculate
    g_cached_rsi25 := use_rsi_25 ? f_rsi_calc_price(25.0, close, auc_current, adc_current) : na
    g_cached_rsi30 := use_rsi_30 ? f_rsi_calc_price(30.0, close, auc_current, adc_current) : na
    g_cached_rsi50 := use_rsi_50 ? f_rsi_calc_price(50.0, close, auc_current, adc_current) : na
    g_cached_rsi70 := use_rsi_70 ? f_rsi_calc_price(70.0, close, auc_current, adc_current) : na
    g_cached_rsi75 := use_rsi_75 ? f_rsi_calc_price(75.0, close, auc_current, adc_current) : na
    g_cached_rsi_custom := i_show_rsi_custom ? f_rsi_calc_price(i_rsi_custom_level, close, auc_current, adc_current) : na
    g_last_calc_bar := bar_index

// ═══════════════════════════════════════════════════════════════════════════
// 🎨 RENDERIZAÇÃO VISUAL
// ═══════════════════════════════════════════════════════════════════════════

// EMA
plot(i_showEMA ? ema_value : na, title='EMA', color=i_emaColor, linewidth=i_emaWidth)

// RSI Lines
plot(i_show_rsi_25 ? g_cached_rsi25 : na, 'RSI 25', color.new(#00bcd4, 0), 1, plot.style_line)
plot(i_show_rsi_30 ? g_cached_rsi30 : na, 'RSI 30', color.new(color.red, 0), 1, plot.style_line)
plot(i_show_rsi_50 ? g_cached_rsi50 : na, 'RSI 50', color.new(color.gray, 0), 1, plot.style_line)
plot(i_show_rsi_70 ? g_cached_rsi70 : na, 'RSI 70', color.new(color.green, 0), 1, plot.style_line)
plot(i_show_rsi_75 ? g_cached_rsi75 : na, 'RSI 75', color.new(#ff5722, 0), 1, plot.style_line)
plot(i_show_rsi_custom ? g_cached_rsi_custom : na, 'RSI Custom', i_rsi_custom_color, 2, plot.style_line)

// === TABELA RSI MTF ===
bool show_col1 = i_table_show_col1
bool show_col2 = i_table_show_col2
int total_cols = 2
int col_p1 = na
if show_col1
    col_p1 := total_cols
    total_cols += 1
int col_p2 = na
if show_col2
    col_p2 := total_cols
    total_cols += 1

pos_rsi = switch i_table_position
    'top_right' => position.top_right
    'top_left' => position.top_left
    'bottom_right' => position.bottom_right
    => position.bottom_left


if i_table_show and barstate.islast
    bool positionChanged = i_table_position != g_prev_table_position
    int current_col_config = (show_col1 ? 1 : 0) + (show_col2 ? 2 : 0)
    if (current_col_config != g_prev_col_config or positionChanged) and not na(g_rsi_table)
        table.delete(g_rsi_table)
        g_rsi_table := na
    g_prev_col_config := current_col_config
    g_prev_table_position := i_table_position
    if na(g_rsi_table)
        g_rsi_table := table.new(pos_rsi, total_cols, MAX_TABLE_ROWS, bgcolor=color.new(#282a36, 0), border_width=0, frame_width=2, frame_color=color.new(#6272a4, 0))
        f_table_seed_cells(g_rsi_table, total_cols, MAX_TABLE_ROWS)
    color tableHeaderBg = color.new(#44475a, 0)
    color tableHeaderText = color.new(#bd93f9, 0)
    f_table_set_cell(g_rsi_table, 0, 0, '  TF  ', tableHeaderBg, tableHeaderText, size.small)
    f_table_set_cell(g_rsi_table, 1, 0, '    RSI     ', tableHeaderBg, tableHeaderText, size.small)
    if show_col1
        f_table_set_cell(g_rsi_table, col_p1, 0, '        ' + str.tostring(i_table_col1_level, '#') + '        ', tableHeaderBg, tableHeaderText, size.small)
    if show_col2
        f_table_set_cell(g_rsi_table, col_p2, 0, '        ' + str.tostring(i_table_col2_level, '#') + '        ', tableHeaderBg, tableHeaderText, size.small)
    for i = 0 to RSI_MTF_SLOT_COUNT - 1
        RSISlot slot = g_rsi_slots.get(i)
        rsi_val = slot.rsi
        [bg, txt_clr] = f_rsi_color(rsi_val)
        f_table_set_cell(g_rsi_table, 0, i + 1, f_rsi_tf_display(i), bg, txt_clr, size.small)
        f_table_set_cell(g_rsi_table, 1, i + 1, na(rsi_val) ? '—' : str.tostring(rsi_val, '#.##'), bg, txt_clr, size.normal)
        if show_col1
            p1 = f_rsi_calc_price(i_table_col1_level, slot.close, slot.auc, slot.adc)
            bg1 = (not na(rsi_val) and rsi_val <= i_table_col1_level) ? color.new(#3de1c7, 20) : color.new(#282a36, 0)
            txt1 = (not na(rsi_val) and rsi_val <= i_table_col1_level) ? color.new(#282a36, 0) : color.new(#f8f8f2, 0)
            f_table_set_cell(g_rsi_table, col_p1, i + 1, na(p1) ? '—' : str.tostring(p1, format.mintick), bg1, txt1, size.normal)
        if show_col2
            p2 = f_rsi_calc_price(i_table_col2_level, slot.close, slot.auc, slot.adc)
            bg2 = (not na(rsi_val) and rsi_val >= i_table_col2_level) ? color.new(#ff4d8d, 20) : color.new(#282a36, 0)
            txt2 = (not na(rsi_val) and rsi_val >= i_table_col2_level) ? color.new(#282a36, 0) : color.new(#f8f8f2, 0)
            f_table_set_cell(g_rsi_table, col_p2, i + 1, na(p2) ? '—' : str.tostring(p2, format.mintick), bg2, txt2, size.normal)





// ═══════════════════════════════════════════════════════════════════════════
// 📊 LÓGICA ICT - HTF CANDLES
// ═══════════════════════════════════════════════════════════════════════════
int cnt = 0
int last = f_htf_enabled()
int offset = settings.offset

// [FIX v1.2.3] Pré-calcular triggers de tempo para evitar warnings do compilador
bool new1 = ta.change(time(htf1.settings.htf)) > 0
bool new2 = ta.change(time(htf2.settings.htf)) > 0
bool new3 = ta.change(time(htf3.settings.htf)) > 0
bool new4 = ta.change(time(htf4.settings.htf)) > 0
bool new5 = ta.change(time(htf5.settings.htf)) > 0
bool new6 = ta.change(time(htf6.settings.htf)) > 0

array<bool> is_new_arr = array.from(new1, new2, new3, new4, new5, new6)
array<bool> current_shows = array.from(SettingsHTF1.show, SettingsHTF2.show, SettingsHTF3.show, SettingsHTF4.show, htf5_show, htf6_show)

for i = 0 to 5
    CandleSet cs = g_htfs.get(i)
    if f_can_render_htf(current_shows.get(i), cs.settings.htf, cnt, last)
        [nextCnt, nextOffset] = f_process_htf(cs, is_new_arr.get(i), cnt, last, offset)
        cnt := nextCnt
        offset := nextOffset

if not settings.trace_show or cnt == 0
    f_clear_trace()
else if not settings.label_show
    f_clear_trace_labels()

f_cleanup_candle_set(CandleSet candleSet) =>
    if candleSet.candles.size() > 0
        for i = candleSet.candles.size() - 1 to 0
            c = candleSet.candles.get(i)
            box.delete(c.body)
            line.delete(c.wick_up)
            line.delete(c.wick_down)
            if not na(c.dow_label)
                c.dow_label.delete()
        candleSet.candles.clear()
    if candleSet.imbalances.size() > 0
        for i = candleSet.imbalances.size() - 1 to 0
            box.delete(candleSet.imbalances.get(i).b)
        candleSet.imbalances.clear()
    candleSet.ClearHtfLabels()
// [FIX v1.2.2] Garbage collection ao desativar HTF
for i = 0 to 5
    CandleSet cs = g_htfs.get(i)
    bool is_showing = current_shows.get(i)
    if not is_showing and g_prev_shows.get(i)
        f_cleanup_candle_set(cs)
    g_prev_shows.set(i, is_showing)

// [FIX v1.2.0] Garbage collection: limpa tabela RSI quando feature desligada
if not i_table_show and not na(g_rsi_table)
    table.delete(g_rsi_table)
    g_rsi_table := na
    g_prev_col_config := 0
    g_prev_table_position := ''
// ═══════════════════════════════════════════════════════════════════════════
// 🔍 DEBUG MODE
// ═══════════════════════════════════════════════════════════════════════════
// [FIX v1.2.0] Protegido contra NaN — usa nz() e na() checks

if i_fvg_debug
    if na(g_debug_table)
        g_debug_table := table.new(position.bottom_left, 2, 8, bgcolor=color.new(#282a36, 0), border_width=2, border_color=color.new(#bd93f9, 0))
        table.cell(g_debug_table, 0, 0, '🔍 FVG Debug V1.2.12', text_color=color.new(#f8f8f2, 0), bgcolor=color.new(#6272a4, 0))
        table.merge_cells(g_debug_table, 0, 0, 1, 0)
    if barstate.islast
        activeCount = g_active_fvgs.size()
        table.cell(g_debug_table, 0, 1, 'FVGs Ativos:', text_color=color.new(#6272a4, 0), text_size=size.small)
        table.cell(g_debug_table, 1, 1, str.tostring(activeCount)+'/'+str.tostring(i_fvg_max_count), text_color=activeCount>12?color.new(#ffb86c, 0):color.new(#50fa7b, 0), text_size=size.small)
        table.cell(g_debug_table, 0, 2, 'Modo:', text_color=color.new(#6272a4, 0), text_size=size.small)
        table.cell(g_debug_table, 1, 2, i_fvg_auto_threshold?'📊 ATR':(i_fvg_adaptive_tf?'⚙️ Adaptativo':'📍 Fixo'), text_color=color.new(#f8f8f2, 0), bgcolor=color.new(#44475a, 0), text_size=size.small)
        table.cell(g_debug_table, 0, 3, 'Threshold:', text_color=color.new(#6272a4, 0), text_size=size.small)
        table.cell(g_debug_table, 1, 3, na(thresholdUsed) ? '—' : str.tostring(nz(thresholdUsed, 0)*100,'#.###')+'%', text_color=color.new(#f8f8f2, 0), text_size=size.small)
        table.cell(g_debug_table, 0, 4, 'ATR('+str.tostring(i_atr_period)+'):', text_color=color.new(#6272a4, 0), text_size=size.small)
        table.cell(g_debug_table, 1, 4, na(atrValue) ? '—' : str.tostring(atrValue, format.mintick), text_color=color.new(#8be9fd, 0), text_size=size.small)
        table.cell(g_debug_table, 0, 5, 'Mitigação:', text_color=color.new(#6272a4, 0), text_size=size.small)
        table.cell(g_debug_table, 1, 5, i_fvg_mitigation_type, text_color=color.new(#50fa7b, 0), text_size=size.tiny)
        table.cell(g_debug_table, 0, 6, 'TF Seconds:', text_color=color.new(#6272a4, 0), text_size=size.small)
        table.cell(g_debug_table, 1, 6, str.tostring(g_tf_seconds), text_color=color.new(#f8f8f2, 0), text_size=size.small)
        table.cell(g_debug_table, 0, 7, 'Último FVG:', text_color=color.new(#6272a4, 0), text_size=size.small)
        if activeCount > 0
            lastFvg = g_active_fvgs.get(0)
            fvgSize = math.abs(lastFvg.top - lastFvg.bottom)
            fvgPct = (fvgSize / math.max(lastFvg.bottom, syminfo.mintick)) * 100
            table.cell(g_debug_table, 1, 7, (lastFvg.isBull?'🟢 Bull':'🔴 Bear')+' ('+str.tostring(fvgPct,'#.##')+'%)', text_color=lastFvg.isBull?color.new(#50fa7b, 0):color.new(#ff5555, 0), text_size=size.tiny)
        else
            table.cell(g_debug_table, 1, 7, 'Nenhum', text_color=color.new(#6272a4, 0), text_size=size.small)
else if not i_fvg_debug and not na(g_debug_table)
    g_debug_table.delete()
    g_debug_table := na

// ═══════════════════════════════════════════════════════════════════════════
// 🔔 ALERTAS
// ═══════════════════════════════════════════════════════════════════════════
bool new_bull_fvg = didAddBullFvg
bool new_bear_fvg = didAddBearFvg

alertcondition(new_bull_fvg, title="Novo FVG de Alta", message="🟢 Novo FVG de Alta Detectado!")
alertcondition(new_bear_fvg, title="Novo FVG de Baixa", message="🔴 Novo FVG de Baixa Detectado!")
alertcondition(ta.crossover(rsi_current, 70.0), title="RSI Sobrecomprado (>70)", message="⚠️ RSI Cruzou 70 para cima")
alertcondition(ta.crossunder(rsi_current, 30.0), title="RSI Sobrevendido (<30)", message="⚠️ RSI Cruzou 30 para baixo")
